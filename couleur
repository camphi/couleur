#!/usr/bin/env bash

declare -A styles=(
    [bold]="1"       [dim]="2"        [italic]="3"     [underline]="4"
    [blink]="5"      [reverse]="7"    [reset]="0"      [inverse]="7"
    [black]="30"     [red]="31"       [green]="32"     [yellow]="33"
    [blue]="34"      [magenta]="35"   [cyan]="36"      [white]="37"
    [bg_black]="40"  [bg_red]="41"    [bg_green]="42"  [bg_yellow]="43"
    [bg_blue]="44"   [bg_magenta]="45" [bg_cyan]="46"   [bg_white]="47"
)

rules_regex=()
rules_ansi=()

awk_unbuffered=0
awk_ignore_case=0
awk_null_data=0
awk_filter=0
awk_fixed=0

show_help() {
    cat << EOF
Usage: command | ${0##*/} [global_options] [pattern_options]

Global Options:
  -u, --unbuffered          Flush output instantly (ideal for tail -f)
  -i, --ignore-case         Make all pattern matches case-insensitive
  -z, --zero-terminated     Treat records as null-separated fields
  -f, --filter              Only output lines that match at least one rule
  -p, --pristine            Force remove ANSI cntrl from stdin
  -h, --help                Show this help block
  --                        Explicitly signals the end of global options

Inline Pattern Switches (No style arguments required):
  -n <regex>                Highlight match using inverse video (Default)
  -r <regex>                Highlight match in Bold Red
  -g <regex>                Highlight match in Bold Green
  -y <regex>                Highlight match in Bold Yellow

Standard Positional Syntax:
  [<style_spec>] <regex>    If style_spec is omitted, defaults to inverse.

Examples:
  tail -f log.txt | ${0##*/} -i -r 'error' -y 'warn' -g 'ok'
  tail -f /var/log/syslog | ${0##*/} -r 'error' -y 'warn'
  cat build.log | ${0##*/} 'bold,rgb(255,50,50)' 'failed' 'bg_#007800,white' 'passed'
  echo "123456789" | ${0##*/} red "123456789" blue "234" green "456"
EOF
}

add_color_rule() {
    local regex="$1"
    local style_spec="${2,,}"

    if [[ -z "${regex}" ]]; then
        echo "Error: Regex pattern cannot be empty. Skipping." >&2
        return
    fi

    style_spec="${style_spec// /}"
    local -a codes=()
    local remaining="${style_spec}"
    local token_pattern='^(rgb\([^)]*\)|bg_rgb\([^)]*\)|[^,]+)'

    while [[ -n "${remaining}" ]]; do
        if [[ "${remaining}" =~ ${token_pattern} ]]; then
            local comp="${BASH_REMATCH[1]}"
            remaining="${remaining#"$comp"}"
            remaining="${remaining#,}"

            if [[ -n "${styles[$comp]}" ]]; then
                codes+=("${styles[$comp]}")
            elif [[ "${comp}" =~ ^[0-9]+$ ]] && (( comp <= 255 )); then
                codes+=("38" "5" "${comp}")
            elif [[ "${comp}" =~ ^bg_([0-9]+)$ ]] && (( BASH_REMATCH[1] <= 255 )); then
                codes+=("48" "5" "${BASH_REMATCH[1]}")
            elif [[ "${comp}" =~ ^rgb\(([0-9]+),([0-9]+),([0-9]+)\)$ ]]; then
                if (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 && BASH_REMATCH[3] <= 255 )); then
                    codes+=("38" "2" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
                fi
            elif [[ "${comp}" =~ ^bg_rgb\(([0-9]+),([0-9]+),([0-9]+)\)$ ]]; then
                if (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 && BASH_REMATCH[3] <= 255 )); then
                    codes+=("48" "2" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
                fi
            elif [[ "${comp}" =~ ^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$ ]]; then
                codes+=("38" "2" "$((16#${BASH_REMATCH[1]}))" "$((16#${BASH_REMATCH[2]}))" "$((16#${BASH_REMATCH[3]}))")
            elif [[ "${comp}" =~ ^bg_#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$ ]]; then
                codes+=("48" "2" "$((16#${BASH_REMATCH[1]}))" "$((16#${BASH_REMATCH[2]}))" "$((16#${BASH_REMATCH[3]}))")
            else
                echo "Warning: Ignoring invalid style modifier '${comp}'" >&2
            fi
        else
            remaining="${remaining#?}"
        fi
    done

    [[ ${#codes[@]} -eq 0 ]] && codes+=("7")

    local joined_codes
    IFS=';' joined_codes="${codes[*]}"

    rules_regex+=("${regex}")
    rules_ansi+=($'\e['"${joined_codes}m")
}

# Main Start
# Parse Global Operational Flags
while (( $# > 0 )); do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -u|--unbuffered)
            awk_unbuffered=1
            shift
            ;;
        -i|--ignore-case)
            awk_ignore_case=1
            shift
            ;;
        -z|--null-data|--zero-terminated)
            awk_null_data=1
            shift
            ;;
        -f|--filter)
            awk_filter=1
            shift
            ;;
        -p|--pristine)
            awk_pristine=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -n|-r|-g|-y)
            break
            ;;
        -*)
            echo "Error: Unknown global option '$1'" >&2
            exit 1
            ;;
        *) break ;;
    esac
done

if [[ -t 0 ]]; then
    show_help
    exit 1
fi

if (( $# < 1 )); then
    echo "Error: At least one regex pattern is required." >&2
    exit 1
fi

# Process Color/Regex Configurations
while (( $# > 0 )); do
    case "$1" in
        -n)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires a regex argument." >&2; exit 1; }
            add_color_rule "$2" "inverse"
            shift 2
            ;;
        -r)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires a regex argument." >&2; exit 1; }
            add_color_rule "$2" "red,bold"
            shift 2
            ;;
        -g)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires a regex argument." >&2; exit 1; }
            add_color_rule "$2" "green,bold"
            shift 2
            ;;
        -y)
            [[ $# -lt 2 ]] && { echo "Error: $1 requires a regex argument." >&2; exit 1; }
            add_color_rule "$2" "yellow,bold"
            shift 2
            ;;
        *)
            # Style-First Check: If lookahead validates a style token block, pair it
            if (( $# >= 2 )); then
                add_color_rule "$2" "$1"
                shift 2
            else
                # Default fallback: Treat argument as clean target regex
                add_color_rule "$1" "inverse"
                shift 1
            fi
            ;;
    esac
done

awk_args=()
for i in "${!rules_regex[@]}"; do
    awk_args+=("${rules_regex[i]}" "${rules_ansi[i]}")
done

awk \
    -v ic="${awk_ignore_case}" \
    -v ub="${awk_unbuffered}" \
    -v nd="${awk_null_data}" \
    -v fl="${awk_filter}" \
    -v pr="${awk_pristine}" '
BEGIN {
    IGNORECASE = ic
    if (nd) { RS = "\0"; ORS = "\0" }

    rule_count = 0
    for (i = 1; i < ARGC; i += 2) {
        rule_count++
        patterns[rule_count] = ARGV[i]
        colors[rule_count] = ARGV[i+1]
    }
    for (i = 1; i < ARGC; i++) ARGV[i] = ""
}
{
    # remove all color codes control characters
    if (pr) {gsub(/\x1b\[[0-9;]*m/, "")}
    len = length($0)
    delete char_color
    line_has_match = 0

    # Pass 1: Trace all targets across uncolored text boundaries
    for (r = 1; r <= rule_count; r++) {
        pat = patterns[r]
        col = colors[r]
        start = 1

        while (start <= len) {
            if (!match(substr($0, start), pat)) break
            m_start = start + RSTART - 1
            m_len = RLENGTH

            line_has_match = 1

            if (m_len == 0) {
                if (!(m_start in char_color)) char_color[m_start] = col
                start++
                continue
            }

            for (i = m_start; i < m_start + m_len; i++) {
                char_color[i] = col
            }

            start = m_start + m_len
        }
    }

    # Filter for matched lines only
    if (fl && !line_has_match) next

    # Pass 2: Chunk-Buffered Rendering Engine
    last_color = ""
    chunk_start = 1
    for (i = 1; i <= len; i++) {
        curr_color = char_color[i]
        if (curr_color != last_color) {
            if (i > chunk_start) {
                printf "%s", substr($0, chunk_start, i - chunk_start)
            }
            if (last_color != "") printf "%s", "\033[0m"
            if (curr_color != "") printf "%s", curr_color
            last_color = curr_color
            chunk_start = i
        }
    }

    # print remaining characters
    if (len >= chunk_start) {
        printf "%s", substr($0, chunk_start, len - chunk_start + 1)
    }

    # close the last color change
    if (last_color != "") {
        printf "%s", "\033[0m"
    }

    # output the correct line-ending character
    print "" 

    if (ub) fflush()
}
' "${awk_args[@]}"
