#!/usr/bin/env bash

declare -A styles=(
    [bold]="1"       [dim]="2"        [italic]="3"     [underline]="4"
    [blink]="5"      [reverse]="7"    [reset]="0"      [inverse]="7"
    [black]="30"     [red]="31"       [green]="32"     [yellow]="33"
    [blue]="34"      [magenta]="35"   [cyan]="36"      [white]="37"
    [bg_black]="40"  [bg_red]="41"    [bg_green]="42"  [bg_yellow]="43"
    [bg_blue]="44"   [bg_magenta]="45" [bg_cyan]="46"   [bg_white]="47"
)

rules_regex=()
rules_ansi=()

awk_unbuffered=0
awk_ignore_case=0
awk_null_data=0
awk_filter=0
awk_pristine=0

show_help() {
    cat << EOF
Usage: command | ${0##*/} [global_options] [pattern_options]

Global Options:
  -u, --unbuffered              Flush output instantly (ideal for tail -f)
  -i, --ignore-case             Make all pattern matches case-insensitive
  -z, --null-data               Treat records as null-separated fields
  -f, --filter                  Only output lines that match at least one rule
  -p, --pristine                Force remove ANSI cntrl from stdin
  -h, --help                    Show this help block
  --                            Explicitly signals the end of global options

Pattern Options:
  -n, --negative <regex>        Highlight match using inverse video (Default)
  -r, --red <regex>             Highlight match in Bold Red
  -g, --green <regex>           Highlight match in Bold Green
  -y, --yellow <regex>          Highlight match in Bold Yellow

Standard Positional Syntax:
  <style_spec> <regex>          style_spec is a comma(",") delimited list of
                                color, background color, and modifiers. The 
                                colours can be one of the 8 basic colors, or 
                                a rgb code, or a hex-color.
                                regex is an ERE (Extended Regular Expression).
Ex: 
tail -f var/log/system.log | couleur -u -f -r 'ERROR' -y 'WARNING'
cat /var/log/dpkg.log | couleur -r ' trigproc ' -y ' status ' -g ' configure '
parallel --tag-string server.{}.cloud -j0 ssh server.{}.cloud -ttt 'tail -f var/log/system.log' ::: {1..55} | couleur -u cyan '^[^\t]+\t' F54927,bg_rgb(238,245,39),bold ERREUR '\[[0-9]{4}-[0-9]{2}-[0-9]{2}[0-9 -:T]\+00:00\]'
EOF
}

add_color_rule() {
    local regex="$1"
    local style_spec="${2,,}"

    [[ -z "${regex}" ]] && return
    style_spec="${style_spec// /}"
    local -a codes=()
    local remaining="${style_spec}"
    local token_pattern='^(rgb\([^)]*\)|bg_rgb\([^)]*\)|[^,]+)'

    while [[ -n "${remaining}" ]]; do
        if [[ "${remaining}" =~ ${token_pattern} ]]; then
            local comp="${BASH_REMATCH[1]}"
            remaining="${remaining#"$comp"}"
            remaining="${remaining#,}"

            if [[ -n "${styles[$comp]}" ]]; then
                codes+=("${styles[$comp]}")
            elif [[ "${comp}" =~ ^[0-9]+$ ]] && (( comp <= 255 )); then
                codes+=("38" "5" "${comp}")
            elif [[ "${comp}" =~ ^bg_([0-9]+)$ ]] && (( BASH_REMATCH[1] <= 255 )); then
                codes+=("48" "5" "${BASH_REMATCH[1]}")
            elif [[ "${comp}" =~ ^rgb\(([0-9]+),([0-9]+),([0-9]+)\)$ ]]; then
                if (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 && BASH_REMATCH[3] <= 255 )); then
                    codes+=("38" "2" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
                fi
            elif [[ "${comp}" =~ ^bg_rgb\(([0-9]+),([0-9]+),([0-9]+)\)$ ]]; then
                if (( BASH_REMATCH[1] <= 255 && BASH_REMATCH[2] <= 255 && BASH_REMATCH[3] <= 255 )); then
                    codes+=("48" "2" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
                fi
            elif [[ "${comp}" =~ ^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$ ]]; then
                codes+=("38" "2" "$((16#${BASH_REMATCH[1]}))" "$((16#${BASH_REMATCH[2]}))" "$((16#${BASH_REMATCH[3]}))")
            elif [[ "${comp}" =~ ^bg_#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$ ]]; then
                codes+=("48" "2" "$((16#${BASH_REMATCH[1]}))" "$((16#${BASH_REMATCH[2]}))" "$((16#${BASH_REMATCH[3]}))")
            fi
        else
            remaining="${remaining#?}"
        fi
    done

    [[ ${#codes[@]} -eq 0 ]] && codes+=("7")
    local joined_codes
    IFS=';' joined_codes="${codes[*]}"

    rules_regex+=("${regex}")
    rules_ansi+=($'\e['"${joined_codes}m")
}

# Parse Global Options
while (( $# > 0 )); do
    case "$1" in
        -h|--help)          show_help; exit 0 ;;
        -u|--unbuffered)    awk_unbuffered=1; shift ;;
        -i|--ignore-case)   awk_ignore_case=1; shift ;;
        -z|--null-data)     awk_null_data=1; shift ;;
        -f|--filter)        awk_filter=1; shift ;;
        -p|--pristine)      awk_pristine=1; shift ;;
        --)                 shift; break ;;
        *)                  break ;;
    esac
done

if [[ -t 0 ]]; then show_help; exit 1; fi

# Process Positional Style-Regex Pairs
while (( $# > 0 )); do
    case "$1" in
        -n|--negative)      add_color_rule "$2" "inverse"; shift 2 ;;
        -r|--red)           add_color_rule "$2" "red,bold"; shift 2 ;;
        -g|--green)         add_color_rule "$2" "green,bold"; shift 2 ;;
        -y|--yellow)        add_color_rule "$2" "yellow,bold"; shift 2 ;;
        *)
            if (( $# >= 2 )); then
                add_color_rule "$2" "$1"; shift 2
            else
                add_color_rule "$1" "inverse"; shift 1
            fi
            ;;
    esac
done

awk_args=()
for i in "${!rules_regex[@]}"; do
    awk_args+=("${rules_regex[i]}" "${rules_ansi[i]}")
done

awk \
    -v ic="${awk_ignore_case}" \
    -v ub="${awk_unbuffered}" \
    -v nd="${awk_null_data}" \
    -v fl="${awk_filter}" \
    -v pr="${awk_pristine}" '
BEGIN {
    IGNORECASE = ic
    if (nd) { RS = "\0"; ORS = "\0" }

    rule_count = 0
    for (i = 1; i < ARGC; i += 2) {
        rule_count++
        patterns[rule_count] = ARGV[i]
        colors[rule_count] = ARGV[i+1]
    }
    for (i = 1; i < ARGC; i++) ARGV[i] = ""
}
{
    if (pr) { gsub(/\x1b\[[0-9;]*m/, "") }
    len = length($0)
    line_has_match = 0
    delete char_color

    # Extraction
    for (r = 1; r <= rule_count; r++) {
        pat = patterns[r]
        col = colors[r]

        line_copy = $0
        if (match(line_copy, pat)) {
            line_has_match = 1
            gsub(pat, "\001&\002", line_copy)

            num_chunks = split(line_copy, chunks, "\001")
            orig_idx = 1 + length(chunks[1])

            for (c_idx = 2; c_idx <= num_chunks; c_idx++) {
                chunk = chunks[c_idx]
                p2 = index(chunk, "\002")
                match_len = p2 - 1

                if (match_len == 0) {
                    if (!(orig_idx in char_color)) char_color[orig_idx] = col
                } else {
                    for (i = orig_idx; i < orig_idx + match_len; i++) {
                        char_color[i] = col
                    }
                }
                orig_idx += match_len + (length(chunk) - p2)
            }
        }
    }

    if (fl && !line_has_match) next

    # Coloration
    last_color = ""
    chunk_start = 1
    for (i = 1; i <= len; i++) {
        curr_color = char_color[i]
        if (curr_color != last_color) {
            if (i > chunk_start) {
                printf "%s", substr($0, chunk_start, i - chunk_start)
            }
            if (last_color != "") printf "%s", "\033[0m"
            if (curr_color != "") printf "%s", curr_color
            last_color = curr_color
            chunk_start = i
        }
    }
    if (len >= chunk_start) {
        printf "%s", substr($0, chunk_start, len - chunk_start + 1)
    }
    if (last_color != "") printf "%s", "\033[0m"
    print ""

    if (ub) fflush()
}
' "${awk_args[@]}"
